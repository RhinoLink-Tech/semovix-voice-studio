{
  "name": "semovix-voice-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./electron/build/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:api": "PORT=3210 tsx server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "tsx server.ts",
    "start:production": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "dev:desktop": "bun run build:electron && node scripts/run-electron.mjs electron/build/main.cjs",
    "desktop:prod": "bun run build && bun run build:electron && node scripts/run-electron.mjs electron/build/main.cjs --prod",
    "smoke:desktop": "tsx scripts/smoke-desktop.ts",
    "package:dir": "node scripts/release.mjs --dir",
    "dist:mac": "node scripts/release.mjs --mac",
    "dist:win": "node scripts/release.mjs --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^8.11.2",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs",
    "electron"
  ]
}
